OPENROUTER_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_SCRAPER_ZONE=
BRIGHTDATA_BROWSER_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_API_URL=https://api.brightdata.com/request
BRIGHTDATA_NUM_RESULTS=5
BRIGHTDATA_MAX_CONCURRENCY=10
BRIGHTDATA_QUERIES_PER_BATCH=5
BRIGHTDATA_TIMEOUT_SECONDS=15
BRIGHTDATA_CACHE_DIR=cache/brightdata
BRIGHTDATA_MIN_CONTENT_CHARS=120
BRIGHTDATA_MAX_CONTENT_CHARS=200000
ALPHA_VANTAGE_API_KEY=

LOG_LEVEL=INFO
CACHE_TTL_HOURS=4
MAX_FACTS_PER_DOCUMENT=10
FACT_MIN_CONFIDENCE=0.60
SAFE_MIN_SUPPORT_RATIO=0.50
SAFE_MAX_CONCURRENT=5
FINBERT_MODEL=ProsusAI/finbert
FINBERT_BATCH_SIZE=32
FINBERT_DEVICE=cpu
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PULSELENS_DISABLE_EMBEDDINGS=false

# Planning and quality-gate thresholds. Defaults are strict by design; weak
# retrieval should produce PARTIAL_PASS/LOW_COVERAGE, not an overconfident PASS.
AGENT1_MIN_QUERIES=40
AGENT1_MAX_QUERIES=50
AGENT1_MIN_EXPANSION_QUERIES=5
AGENT1_MAX_EXPANSION_QUERIES=10
AGENT1_MIN_SIGNAL_TYPES=7
AGENT1_MAX_MALFORMED_QUERY_RATE=0.10
MAX_EXPANSION_ROUNDS=2
QUALITY_MIN_FACTS=50
QUALITY_MIN_SIGNAL_TYPES=7
QUALITY_MIN_COMPANY_COVERAGE_RATIO=0.75
QUALITY_MAX_ZERO_DOC_QUERY_RATE=0.35
QUALITY_MAX_FETCH_ERROR_RATE=0.35
QUALITY_MIN_SOURCE_COUNT=15

# Comma-separated allowed CORS origins (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Per-agent model overrides — defaults to google/gemini-2.5-flash
AGENT1_MODEL=google/gemini-2.5-flash
AGENT3_MODEL=google/gemini-2.5-flash
AGENT5_MODEL=google/gemini-2.5-flash
AGENT6_MODEL=google/gemini-2.5-flash
AGENT7_MODEL=google/gemini-2.5-flash
AGENT8_MODEL=google/gemini-2.5-flash
