OPENROUTER_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_SCRAPER_ZONE=
ALPHA_VANTAGE_API_KEY=

LOG_LEVEL=INFO
CACHE_TTL_HOURS=4
MAX_FACTS_PER_DOCUMENT=10
FINBERT_DEVICE=cpu

# Comma-separated allowed CORS origins (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Per-agent model overrides — defaults to google/gemini-2.5-flash
AGENT1_MODEL=google/gemini-2.5-flash
AGENT3_MODEL=google/gemini-2.5-flash
AGENT5_MODEL=google/gemini-2.5-flash
AGENT6_MODEL=google/gemini-2.5-flash
AGENT7_MODEL=google/gemini-2.5-flash
AGENT8_MODEL=google/gemini-2.5-flash
